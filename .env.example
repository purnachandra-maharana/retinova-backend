# Port configuration (default 10000 for Render)
PORT=10000
NODE_ENV=development

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://retinova-frontend.onrender.com

# PostgreSQL Connection (Use DATABASE_URL or individual credentials)
DATABASE_URL=postgresql://postgres:password@localhost:5432/retinova_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retinova_db
DB_USER=postgres
DB_PASSWORD=password

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production

# MATLAB Bridge Integration (Optional for local AI execution)
MATLAB_EXE=matlab
MATLAB_PROJECT_PATH=../SIH26038-MATLAB
